# Environment — actual .env is per-machine; .env.example IS committed
.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/

# Output files
output/

# Generated deliverables may contain client PII — never commit them.
# (assets/ holds the committed PPT chrome template, so keep that.)
*.docx
*.pptx
!assets/**

# Installer log
/tmp/fcc-mas-pip.log

# Claude Code — keep skills/ tracked, ignore everything else
.claude/*
!.claude/skills/
!.claude/skills/**

# macOS
.DS_Store
